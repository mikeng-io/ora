# Ora — every env var, no values (design/02 §1). Copy to .env and fill in.

SIGNAL_BASE_URL=http://localhost:18080
SIGNAL_ACCOUNT=+852XXXXXXXX
WHATSAPP_BASE_URL=http://localhost:18081
HONCHO_BASE_URL=http://localhost:8000
HONCHO_WORKSPACE=ora
HONCHO_AI_PEER=ora
MODEL_BASE_URL=https://ollama.com/v1
OLLAMA_CLOUD_API_KEY=
MODEL=deepseek-v4-flash          # the one model, everywhere (ORA-14)
REASONING_GATE=none              # gate · fold · curation
REASONING_TURN=low               # participation turn · tag turn · proactive
EXA_API_KEY=
GOOGLE_MAP_API_KEY=               # the route tool (Directions) on the tag turn; the reference project's key
AMBIGUOUS_API_KEY=
DATABASE_URL=postgresql://ora:ora@localhost:5432/ora
ORA_LOG=./ora.log                 # JSON lines; the console gets the readable grammar (design/01 §7)
ORA_TZ=Asia/Hong_Kong

# clocks (design/01 §5), every knob overridable — leave unset for the defaults below
SETTLE_SECONDS=15
MAX_WINDOW_MESSAGES=6
COOLDOWN_SECONDS=60
FOLD_BATCH=6
NOTES_TICK_SECONDS=30
NOTES_QUIET_SECONDS=0
PROACTIVE_TICK_SECONDS=30
REMIND_LEAD_SECONDS=60
MODEL_TIMEOUT_SECONDS=20
GATE_TIMEOUT_SECONDS=8
